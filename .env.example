# Copy to .env.local and fill in. Never commit real values.

# TMDB "API Read Access Token" (the long one, not the short API key). Server-side only.
TMDB_READ_ACCESS_TOKEN=

# Local Postgres from docker-compose.yml (npm run db:up).
# On Vercel, the Neon integration sets DATABASE_URL (pooled) and DATABASE_URL_UNPOOLED (used by migrations).
DATABASE_URL=postgres://cinemadle:cinemadle@localhost:5433/cinemadle

# Vercel Cron sends this as "Authorization: Bearer <secret>" to /api/cron/casting-call, which builds
# the coming week's Casting call boards. Set it in Vercel (any long random string); locally it only
# matters for calling that route by hand. Without it the route refuses everyone.
CRON_SECRET=
